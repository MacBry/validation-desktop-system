<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plik supresji OWASP Dependency-Check.
  Dodawaj tu wpisy dla potwierdzonych false-positive lub podatności nie dotyczących
  sposobu użycia zależności w tym projekcie. Każdy wpis powinien mieć uzasadnienie i CVE.

  Przykład:
  <suppress>
      <notes>FP: podatność dotyczy komponentu serwerowego, nie używanego w tej aplikacji.</notes>
      <packageUrl regex="true">^pkg:maven/com\.example/.*$</packageUrl>
      <cve>CVE-YYYY-NNNNN</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- log4j-api / log4j-to-slf4j: w projekcie obecny JEST tylko most Log4j2->SLF4J
         (log4j-to-slf4j) oraz samo API (log4j-api). log4j-CORE NIE jest na classpath
         (potwierdzone `mvn dependency:tree`), runtime logowania to Logback. Poniższe CVE
         dotyczą kodu Log4j2, którego u nas nie ma / nie wykonujemy (m.in. Log4j1XmlLayout
         z mostka Log4j1->2). Niewykorzystywane -> supresja. Przegląd przy zmianie stosu logów. -->
    <suppress>
        <notes>FP: brak log4j-core; runtime = Logback. Log4j1XmlLayout z mostka nieużywany.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-(api|to-slf4j)@.*$</packageUrl>
        <cve>CVE-2026-34479</cve>
        <cve>CVE-2026-34477</cve>
        <cve>CVE-2026-49844</cve>
    </suppress>

    <!-- mysql-connector-j: CPE `oracle:mysql_connectors` jest WSPÓLNE dla wszystkich
         konektorów MySQL (J, Net, Python, ODBC...), więc Dependency-Check przypisuje
         sterownikowi Java także CVE z komponentu Connector/NET. Poniższe trzy z CPU
         Oracle lipiec 2026 mają w opisie NVD wprost "component: Connector/Net" -
         nie dotyczą kodu Javy. CVE z komponentu Connector/J (60586, 60623, 60624,
         61082) NIE są supresowane - załatane podbiciem sterownika do 26.7.0.
         Przy każdym kolejnym CPU Oracle'a trzeba przejrzeć nowe CVE tak samo:
         sprawdzić w opisie NVD, którego konektora dotyczą. -->
    <suppress>
        <notes>FP: CVE komponentu Connector/NET, dopasowane przez wspólne CPE oracle:mysql_connectors. Projekt używa wyłącznie Connector/J.</notes>
        <packageUrl regex="true">^pkg:maven/com\.mysql/mysql-connector-j@.*$</packageUrl>
        <cve>CVE-2026-60193</cve>
        <cve>CVE-2026-60192</cve>
        <cve>CVE-2026-60317</cve>
    </suppress>

</suppressions>
