<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mac.bry.desktop.controller.ThermoRecorderModelDialogController" prefWidth="400">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <Label styleClass="title-2" text="%thermorecordermodeldialog.dane_modelu_rejestratora" />
    
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints prefWidth="150" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="%thermorecordermodeldialog.nazwa_modelu" GridPane.rowIndex="0" />
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="%thermorecordermodeldialog.liczba_kanalow" GridPane.rowIndex="1" />
        <Spinner fx:id="channelsSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="%common.rozdzielczosc_c" GridPane.rowIndex="2" />
        <TextField fx:id="resolutionField" promptText="%thermorecordermodeldialog.np_0_100" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="%thermorecordermodeldialog.aktywny" GridPane.rowIndex="3" />
        <CheckBox fx:id="activeCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <Separator />

    <Label styleClass="title-3" text="%thermorecordermodeldialog.dane_katalogowe_producenta" />
    <Label styleClass="text-muted" text="%thermorecordermodeldialog.dane_katalogowe_opis" wrapText="true" />

    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints prefWidth="150" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="%thermorecordermodeldialog.pojemnosc_pamieci" GridPane.rowIndex="0" />
        <TextField fx:id="sampleCapacityField" promptText="%thermorecordermodeldialog.np_16000" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="%thermorecordermodeldialog.zakres_pracy_min" GridPane.rowIndex="1" />
        <TextField fx:id="minOperatingTempField" promptText="%thermorecordermodeldialog.np_minus_30" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="%thermorecordermodeldialog.zakres_pracy_max" GridPane.rowIndex="2" />
        <TextField fx:id="maxOperatingTempField" promptText="%thermorecordermodeldialog.np_70" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="%thermorecordermodeldialog.bateria_wymienna" GridPane.rowIndex="3" />
        <CheckBox fx:id="batteryReplaceableCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="%thermorecordermodeldialog.typ_baterii" GridPane.rowIndex="4" />
        <TextField fx:id="batteryTypeField" promptText="%thermorecordermodeldialog.np_cr2032" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="%thermorecordermodeldialog.zywotnosc_baterii_dni" GridPane.rowIndex="5" />
        <TextField fx:id="batteryLifeDaysField" promptText="%thermorecordermodeldialog.np_500" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label text="%thermorecordermodeldialog.cykl_referencyjny_min" GridPane.rowIndex="6" />
        <TextField fx:id="batteryLifeRefCycleField" promptText="%thermorecordermodeldialog.np_15" GridPane.columnIndex="1" GridPane.rowIndex="6" />

        <Label text="%thermorecordermodeldialog.temperatura_referencyjna" GridPane.rowIndex="7" />
        <TextField fx:id="batteryLifeRefTempField" promptText="%thermorecordermodeldialog.np_25" GridPane.columnIndex="1" GridPane.rowIndex="7" />

        <Label text="%thermorecordermodeldialog.wiek_baterii_mies" GridPane.rowIndex="8" />
        <TextField fx:id="batteryShelfLifeMonthsField" promptText="%thermorecordermodeldialog.np_24" GridPane.columnIndex="1" GridPane.rowIndex="8" />

        <Label text="%thermorecordermodeldialog.limit_pracy_dni" GridPane.rowIndex="9" />
        <TextField fx:id="operatingDurationDaysField" promptText="%thermorecordermodeldialog.np_90" GridPane.columnIndex="1" GridPane.rowIndex="9" />
    </GridPane>

    <Separator />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#handleCancel" text="%common.anuluj" />
        <Button onAction="#handleSave" styleClass="accent" text="%common.zapisz" />
    </HBox>
</VBox>
