<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mac.bry.desktop.controller.PlannerCalendarController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <VBox spacing="5.0">
            <children>
                <Label styleClass="title-1" text="%planner.calendar.title" />
                <Label style="-fx-text-fill: -color-fg-muted;" text="%planner.calendar.subtitle" wrapText="true" />
            </children>
        </VBox>

        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <children>
                <Label text="%planner.calendar.year" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="yearCombo" prefWidth="120.0" />
                <Button mnemonicParsing="false" onAction="#onGenerateSchedule" text="%planner.calendar.generate" />
                <Button mnemonicParsing="false" onAction="#onRefresh" text="%planner.calendar.refresh" />
                <CheckBox fx:id="onlyProblemsCheck" mnemonicParsing="false" text="%planner.calendar.only_problems" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblSummary" style="-fx-text-fill: -color-fg-muted;" />
            </children>
        </HBox>

        <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDueDate" text="%planner.calendar.col_due" prefWidth="95.0" />
                <TableColumn fx:id="colTaskNumber" text="%planner.calendar.col_rpw" prefWidth="100.0" />
                <TableColumn fx:id="colDevice" text="%planner.calendar.col_device" prefWidth="180.0" />
                <TableColumn fx:id="colChamber" text="%planner.calendar.col_chamber" prefWidth="140.0" />
                <TableColumn fx:id="colProcedure" text="%planner.calendar.col_procedure" prefWidth="150.0" />
                <TableColumn fx:id="colStep1" text="%planner.calendar.col_step1" prefWidth="130.0" />
                <TableColumn fx:id="colMeasurementEnd" text="%planner.calendar.col_measurement_end" prefWidth="130.0" />
                <TableColumn fx:id="colReadoutDeadline" text="%planner.calendar.col_readout" prefWidth="130.0" />
                <TableColumn fx:id="colRecorders" text="%planner.calendar.col_recorders" prefWidth="80.0" />
                <TableColumn fx:id="colStatus" text="%planner.calendar.col_status" prefWidth="120.0" />
                <TableColumn fx:id="colResourceStatus" text="%planner.calendar.col_resource" prefWidth="200.0" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
        </TableView>

        <Label fx:id="lblShortageDetail" styleClass="planner-shortage-detail" wrapText="true" visible="false" managed="false" />
    </children>
</VBox>