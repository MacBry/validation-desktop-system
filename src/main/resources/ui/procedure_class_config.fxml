<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mac.bry.desktop.controller.ProcedureClassConfigController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <VBox spacing="5.0">
            <children>
                <Label styleClass="title-1" text="%planner.procedure.title" />
                <Label style="-fx-text-fill: -color-fg-muted;" text="%planner.procedure.subtitle" wrapText="true" />
            </children>
        </VBox>

        <TableView fx:id="configTable" prefHeight="220.0" VBox.vgrow="SOMETIMES">
            <columns>
                <TableColumn fx:id="colName" text="%planner.procedure.col_name" prefWidth="230.0" />
                <TableColumn fx:id="colType" text="%planner.procedure.col_type" prefWidth="150.0" />
                <TableColumn fx:id="colStep1" text="%planner.procedure.col_step1" prefWidth="110.0" />
                <TableColumn fx:id="colStep2" text="%planner.procedure.col_step2" prefWidth="130.0" />
                <TableColumn fx:id="colStep3" text="%planner.procedure.col_step3" prefWidth="110.0" />
                <TableColumn fx:id="colStep4" text="%planner.procedure.col_step4" prefWidth="150.0" />
                <TableColumn fx:id="colStep5" text="%planner.procedure.col_step5" prefWidth="110.0" />
                <TableColumn fx:id="colActive" text="%planner.procedure.col_active" prefWidth="80.0" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
        </TableView>

        <Label styleClass="title-2" text="%planner.procedure.form_title" />

        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="190.0" prefWidth="190.0" />
                <ColumnConstraints minWidth="180.0" prefWidth="180.0" />
                <ColumnConstraints minWidth="190.0" prefWidth="190.0" />
                <ColumnConstraints minWidth="180.0" prefWidth="180.0" />
            </columnConstraints>
            <children>
                <Label text="%planner.procedure.name" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="%planner.procedure.type" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <ComboBox fx:id="typeCombo" prefWidth="180.0" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="%planner.procedure.step1" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Spinner fx:id="step1Spinner" prefWidth="180.0" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Label text="%planner.procedure.step2" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <Spinner fx:id="step2Spinner" prefWidth="180.0" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                <Label text="%planner.procedure.step3" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <Spinner fx:id="step3Spinner" prefWidth="180.0" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <Label text="%planner.procedure.step5" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                <Spinner fx:id="step5Spinner" prefWidth="180.0" GridPane.rowIndex="2" GridPane.columnIndex="3" />

                <Label text="%planner.procedure.step4_interval" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <Spinner fx:id="step4IntervalSpinner" prefWidth="180.0" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                <Label text="%planner.procedure.step4_count" GridPane.rowIndex="3" GridPane.columnIndex="2" />
                <Spinner fx:id="step4CountSpinner" prefWidth="180.0" GridPane.rowIndex="3" GridPane.columnIndex="3" />

                <CheckBox fx:id="activeCheck" mnemonicParsing="false" selected="true" text="%planner.procedure.active" GridPane.rowIndex="4" GridPane.columnIndex="1" />
            </children>
        </GridPane>

        <Label fx:id="lblDerived" styleClass="planner-derived" wrapText="true" />

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button mnemonicParsing="false" onAction="#onNew" text="%planner.procedure.new" />
                <Button mnemonicParsing="false" onAction="#onSave" text="%planner.procedure.save" />
                <Button mnemonicParsing="false" onAction="#onRefresh" text="%planner.procedure.refresh" />
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>