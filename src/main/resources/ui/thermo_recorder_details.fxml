<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mac.bry.desktop.controller.ThermoRecorderDetailsController"
      prefWidth="820" prefHeight="620" styleClass="content-area" stylesheets="@style.css">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <!-- NAGŁÓWEK -->
    <VBox spacing="5">
        <Label fx:id="titleLabel" styleClass="title-2" text="%recorderdetails.title"
               style="-fx-font-weight: bold; -fx-text-fill: #0f172a;" />
        <Label styleClass="text-muted" text="%recorderdetails.subtitle" wrapText="true" />
    </VBox>

    <!-- KARTA WŁAŚCIWOŚCI -->
    <TableView fx:id="detailsTable" VBox.vgrow="ALWAYS" styleClass="audit-table">
        <columns>
            <TableColumn fx:id="sectionColumn" prefWidth="190" text="%recorderdetails.column.section" />
            <TableColumn fx:id="propertyColumn" prefWidth="260" text="%recorderdetails.column.property" />
            <TableColumn fx:id="valueColumn" prefWidth="330" text="%recorderdetails.column.value" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- STOPKA -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#handleClose" text="%recorderdetails.close"
                style="-fx-pref-height: 36px; -fx-pref-width: 100px;" />
    </HBox>
</VBox>