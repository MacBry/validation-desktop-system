<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mac.bry.desktop.controller.OperatorVacationDialogController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <VBox spacing="5.0">
            <children>
                <Label styleClass="title-1" text="%planner.vacation.title" />
                <Label style="-fx-text-fill: -color-fg-muted;" text="%planner.vacation.subtitle" wrapText="true" />
            </children>
        </VBox>

        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="150.0" prefWidth="150.0" />
                <ColumnConstraints minWidth="200.0" prefWidth="200.0" />
                <ColumnConstraints minWidth="120.0" prefWidth="120.0" />
                <ColumnConstraints minWidth="240.0" prefWidth="240.0" />
            </columnConstraints>
            <children>
                <Label text="%planner.vacation.start" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <DatePicker fx:id="startDatePicker" prefWidth="200.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="%planner.vacation.end" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <DatePicker fx:id="endDatePicker" prefWidth="240.0" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="%planner.vacation.reason" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="reasonField" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3" />

                <CheckBox fx:id="unplannedL4Check" mnemonicParsing="false" text="%planner.vacation.unplanned_l4" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3" />
            </children>
        </GridPane>

        <Label fx:id="lblHint" styleClass="planner-hint" wrapText="true" />

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button mnemonicParsing="false" onAction="#onSave" text="%planner.vacation.save" />
                <Button mnemonicParsing="false" onAction="#onRefresh" text="%planner.vacation.refresh" />
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <Label styleClass="title-2" text="%planner.vacation.list_title" />

        <TableView fx:id="vacationTable" prefHeight="240.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colStart" text="%planner.vacation.col_start" prefWidth="120.0" />
                <TableColumn fx:id="colEnd" text="%planner.vacation.col_end" prefWidth="120.0" />
                <TableColumn fx:id="colType" text="%planner.vacation.col_type" prefWidth="160.0" />
                <TableColumn fx:id="colReason" text="%planner.vacation.col_reason" prefWidth="320.0" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
        </TableView>
    </children>
</VBox>